ENV=development
DATABASE_URL=sqlite:///./dev.db
WHATSAPP_DRY_RUN=true
WHATSAPP_TOKEN=replace-with-meta-access-token
WHATSAPP_PHONE_NUMBER_ID=replace-with-phone-number-id
WHATSAPP_VERIFY_TOKEN=replace-with-webhook-verify-token
WHATSAPP_APP_SECRET=replace-with-meta-app-secret
WHATSAPP_API_VERSION=v21.0
PHONE_HASH_SALT=replace-with-a-random-secret
SESSION_SECRET=replace-with-a-random-secret
RATE_LIMIT_PER_HOUR=60